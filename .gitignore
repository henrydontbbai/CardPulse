# ============================================================================
# CardPulse .gitignore
# ============================================================================

# 配置文件（包含敏感信息）
config.yaml
*.local
.env
.env.*
*.pem
*.key

# 运行时生成的文件
state/
logs/
*.log

# 临时文件
tmp/
temp/
*.tmp
*.temp
*.pid

# 系统文件
.DS_Store
Thumbs.db

# 编辑器文件
.vscode/
.idea/
*.swp
*.swo
*~
__pycache__/
*.pyc

# 二进制文件
/cardpulse
*.exe

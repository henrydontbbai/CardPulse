# ============================================================================
# CardPulse .gitignore
# ============================================================================

# 配置文件（包含敏感信息）
config.yaml
*.local

# 运行时生成的文件
state/
logs/
*.log

# 临时文件
tmp/
temp/
*.tmp
*.temp

# 系统文件
.DS_Store
Thumbs.db

# 编辑器文件
.vscode/
.idea/
*.swp
*.swo
*~

# 日志文件
*.log
logs/

# 二进制文件
cardpulse
*.exe

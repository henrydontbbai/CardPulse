#!/bin/bash
# ============================================================================
# CardPulse - SIM卡定时保号工�?# 让每一�?SIM 卡都有跳动的脉搏
# ============================================================================

set -euo pipefail

# 锁文件路径（�?main 中初始化�?CARDPULSE_LOCK_FILE=""

# 清理函数
cleanup() {
    local rc=$?
    # 关闭串口（如果已初始化）
    if [[ -n "${AT_PORT:-}" ]]; then
        at_close 2>/dev/null || true
    fi
    # 锁文件保留在 state 目录；flock 依赖文件路径稳定，退出时只释放文件描述符�?    exit $rc
}
trap cleanup EXIT INT TERM

# 脚本版本
VERSION="1.1.0"

# 颜色输出
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# 脚本目录
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

resolve_lib_dir() {
    local candidates=()

    if [[ -n "${CARDPULSE_LIB_DIR:-}" ]]; then
        candidates+=("$CARDPULSE_LIB_DIR")
    fi

    candidates+=(
        "$(dirname "$SCRIPT_DIR")/lib"
        "/opt/cardpulse/lib"
        "/usr/local/lib/cardpulse"
    )

    local dir
    for dir in "${candidates[@]}"; do
        if [[ -r "$dir/config_reader.sh" && -r "$dir/at_modem.sh" && -r "$dir/sms_sender.sh" && -r "$dir/state_manager.sh" && -r "$dir/notifier.sh" ]]; then
            echo "$dir"
            return 0
        fi
    done

    echo "[ERROR] 无法找到 CardPulse 库目录，请设�?CARDPULSE_LIB_DIR" >&2
    return 1
}

LIB_DIR=""

# 加载模块
load_modules() {
    LIB_DIR="$(resolve_lib_dir)" || exit 1
    # 加载顺序很重�?    source "${LIB_DIR}/config_reader.sh"
    source "${LIB_DIR}/at_modem.sh"
    source "${LIB_DIR}/sms_sender.sh"
    source "${LIB_DIR}/state_manager.sh"
    source "${LIB_DIR}/notifier.sh"
}

# 显示帮助
show_help() {
    echo -e "${BLUE}CardPulse - SIM 卡定时保号工�?{NC}"
    echo -e "版本: ${VERSION}"
    echo ""
    echo "用法: cardpulse [选项]"
    echo ""
    echo "选项:"
    echo "  -c, --config FILE    指定配置文件路径"
    echo "  -f, --force          强制发送（忽略间隔检查）"
    echo "  -s, --status         显示状态信�?
    echo "  -t, --test           测试发送（不记录状态）"
    echo "  -i, --info           显示模组信息"
    echo "  -r, --reset          重置状态（重新开始计时）"
    echo "  -n, --notify         测试通知功能"
    echo "  --notify-channel CH  测试指定通知渠道 (telegram|wechat|wecom|qq|feishu|dingtalk|bark|email)"
    echo "  -v, --version        显示版本"
    echo "  -h, --help           显示帮助"
    echo ""
    echo "示例:"
    echo "  cardpulse                  # 正常执行（检查间隔后发送）"
    echo "  cardpulse --force          # 强制发�?
    echo "  cardpulse --status         # 查看状�?
    echo "  cardpulse --test           # 测试发�?
    echo "  cardpulse --info           # 查看模组信息"
    echo "  cardpulse --notify --notify-channel telegram   # 仅测�?Telegram 通知"
    echo ""
}

# 显示版本
show_version() {
    echo "CardPulse ${VERSION}"
}

require_arg() {
    local option="$1"
    local value="${2:-}"
    if [[ -z "$value" || "$value" == -* ]]; then
        echo -e "${RED}[ERROR] 选项 $option 需要参�?{NC}" >&2
        show_help >&2
        exit 1
    fi
}

validate_notify_channel() {
    local channel="$1"
    case "$channel" in
        telegram|wechat|wecom|qq|feishu|dingtalk|bark|email) return 0 ;;
        *)
            echo -e "${RED}[ERROR] 未知通知渠道: $channel${NC}" >&2
            echo "允许�? telegram, wechat, wecom, qq, feishu, dingtalk, bark, email" >&2
            exit 1
            ;;
    esac
}

acquire_singleton_lock() {
    CARDPULSE_LOCK_FILE="${STATE_DIR}/cardpulse.lock"
    exec 200>"$CARDPULSE_LOCK_FILE"

    if command -v flock >/dev/null 2>&1; then
        if ! flock -n -x 200 2>/dev/null; then
            echo -e "${YELLOW}[WARN] 另一�?CardPulse 实例正在运行，退�?{NC}" >&2
            exit 0
        fi
    else
        echo -e "${YELLOW}[WARN] 未找�?flock，跳过单例锁（macOS 真机测试可接受）${NC}" >&2
    fi
}

# 主流�?main() {
    # 解析参数
    local force_send=false
    local show_status=false
    local test_mode=false
    local show_info=false
    local reset_state=false
    local test_notify=false
    local notify_channel=""
    local config_path=""

    while [[ $# -gt 0 ]]; do
        case $1 in
            -c|--config)
                require_arg "$1" "${2:-}"
                config_path="$2"
                shift 2
                ;;
            -f|--force)
                force_send=true
                shift
                ;;
            -s|--status)
                show_status=true
                shift
                ;;
            -t|--test)
                test_mode=true
                shift
                ;;
            -i|--info)
                show_info=true
                shift
                ;;
            -r|--reset)
                reset_state=true
                shift
                ;;
            -n|--notify)
                test_notify=true
                shift
                ;;
            --notify-channel)
                require_arg "$1" "${2:-}"
                notify_channel="$2"
                validate_notify_channel "$notify_channel"
                shift 2
                ;;
            -v|--version)
                show_version
                exit 0
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            *)
                echo -e "${RED}[ERROR] 未知参数: $1${NC}" >&2
                show_help
                exit 1
                ;;
        esac
    done

    if [[ -n "$notify_channel" && "$test_notify" != "true" ]]; then
        echo -e "${RED}[ERROR] --notify-channel 需要与 --notify 一起使�?{NC}" >&2
        exit 1
    fi

    # 加载模块
    load_modules

    # 设置配置文件路径
    if [[ -n "$config_path" ]]; then
        CONFIG_FILE="$config_path"
    fi

    # 初始化配�?    if ! config_init; then
        exit 1
    fi

    # 初始化状态目�?    state_init

    # 获取单例锁（防止多实例并发）
    acquire_singleton_lock

    # 显示状�?    if [[ "$show_status" == "true" ]]; then
        state_show_status
        exit 0
    fi

    # 重置状�?    if [[ "$reset_state" == "true" ]]; then
        state_reset
        echo -e "${GREEN}[INFO] 状态已重置${NC}"
        exit 0
    fi

    # 测试通知
    if [[ "$test_notify" == "true" ]]; then
        notify_test "$notify_channel"
        exit $?
    fi

    # 验证配置
    if ! config_validate; then
        exit 1
    fi

    # 获取配置
    local phone
    local message
    local interval_days
    phone=$(config_read ".sms.phone" "")
    message=$(config_read ".sms.message" "Hello from CardPulse")
    interval_days=$(config_read ".sms.interval_days" "179")

    # 检测串口设�?    local device
    device=$(sms_detect_device) || device=""
    if [[ -z "$device" ]]; then
        echo -e "${RED}[ERROR] 未找到串口设�?{NC}" >&2
        echo "[INFO] 请检�?" >&2
        echo "  1. 4G 模组是否已连�? >&2
        echo "  2. 是否有串口权�?(dialout �?" >&2
        echo "  3. 配置文件中的 serial.port 是否正确" >&2
        exit 1
    fi

    # 获取串口参数
    local baudrate
    baudrate=$(config_read ".serial.baudrate" "115200")

    # 显示模组信息
    if [[ "$show_info" == "true" ]]; then
        if at_init "$device" "$baudrate"; then
            at_show_info
            at_close
        else
            echo -e "${RED}[ERROR] 串口初始化失�?{NC}" >&2
            exit 1
        fi
        exit 0
    fi

    # 测试模式
    if [[ "$test_mode" == "true" ]]; then
        local phone_masked
        phone_masked=$(config_mask_string "$phone")
        echo -e "${BLUE}[INFO] 测试模式${NC}"
        echo "[INFO] 目标号码: $phone_masked" >&2
        echo "[INFO] 消息长度: ${#message} 字符" >&2

        # 初始化串�?        if ! at_init "$device" "$baudrate"; then
            echo -e "${RED}[ERROR] 串口初始化失�?{NC}" >&2
            exit 1
        fi

        # 验证前置条件
        if ! sms_validate_preconditions; then
            at_close
            exit 1
        fi

        # 发送短�?        local result
        local exit_code=0
        result=$(sms_send_with_retry "$phone" "$message") || exit_code=$?

        at_close

        if [[ $exit_code -eq 0 ]]; then
            echo -e "${GREEN}[SUCCESS] 短信发送成�?{NC}"
            echo "[INFO] 消息引用: $result"
        else
            echo -e "${RED}[ERROR] 短信发送失�?{NC}"
            exit 1
        fi

        exit 0
    fi

    # 正常模式：检查是否需要发�?    if [[ "$force_send" != "true" ]]; then
        if ! state_should_send "$interval_days"; then
            local remaining
            local last_date
            remaining=$(state_get_remaining "$interval_days")
            last_date=$(state_get_last_success_date)
            echo -e "${GREEN}[INFO] 距离上次发送还需 ${remaining} �?{NC}"
            echo "[INFO] 上次发�? $last_date"
            exit 0
        fi
    fi

    # 开始执�?    local phone_masked
    phone_masked=$(config_mask_string "$phone")
    echo -e "${BLUE}[INFO] 开始执行保号任�?..${NC}"
    echo "[INFO] 目标号码: $phone_masked" >&2
    echo "[INFO] 消息长度: ${#message} 字符" >&2
    echo "[INFO] 串口设备: $device" >&2
    echo ""

    # 初始化串�?    if ! at_init "$device" "$baudrate"; then
        echo -e "${RED}[ERROR] 串口初始化失�?{NC}" >&2
        notify_send "failure" "$device" "$phone" "$message"
        exit 1
    fi

    # 验证前置条件
    if ! sms_validate_preconditions; then
        at_close
        notify_send "failure" "$device" "$phone" "$message"
        exit 1
    fi

    # 发送短�?    echo -e "${BLUE}[INFO] 发送短�?..${NC}"
    local result
    local exit_code=0
    result=$(sms_send_with_retry "$phone" "$message") || exit_code=$?

    at_close

    # 记录结果
    if [[ $exit_code -eq 0 ]]; then
        state_record_success
        notify_send "success" "$device" "$phone" "$message"
        echo -e "${GREEN}[SUCCESS] 短信发送成�?{NC}"
        echo "[INFO] 消息引用: $result"
    else
        state_record_failure
        notify_send "failure" "$device" "$phone" "$message"
        echo -e "${RED}[ERROR] 短信发送失�?{NC}"
        exit 1
    fi
}

# 运行主函�?main "$@"

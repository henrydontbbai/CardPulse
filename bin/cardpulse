#!/bin/bash
set -euo pipefail

CARDPULSE_LOCK_FILE=""
VERSION="${CARDPULSE_VERSION:-1.1.0}"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR=""

cleanup() {
    local rc=$?
    if [[ -n "${AT_PORT:-}" ]]; then
        at_close 2>/dev/null || true
    fi
    exit "$rc"
}
trap cleanup EXIT INT TERM

resolve_lib_dir() {
    local candidates=()

    if [[ -n "${CARDPULSE_LIB_DIR:-}" ]]; then
        candidates+=("$CARDPULSE_LIB_DIR")
    fi

    candidates+=(
        "$(dirname "$SCRIPT_DIR")/lib"
        "/opt/cardpulse/lib"
        "/usr/local/lib/cardpulse"
    )

    local dir
    for dir in "${candidates[@]}"; do
        if [[ -r "$dir/config_reader.sh" && -r "$dir/at_modem.sh" && -r "$dir/sms_sender.sh" && -r "$dir/sms_receiver.sh" && -r "$dir/state_manager.sh" && -r "$dir/notifier.sh" ]]; then
            echo "$dir"
            return 0
        fi
    done

    echo "[ERROR] Unable to find CardPulse library directory. Set CARDPULSE_LIB_DIR." >&2
    return 1
}

load_modules() {
    LIB_DIR="$(resolve_lib_dir)" || exit 1
    # shellcheck disable=SC1091
    source "${LIB_DIR}/config_reader.sh"
    # shellcheck disable=SC1091
    source "${LIB_DIR}/at_modem.sh"
    # shellcheck disable=SC1091
    source "${LIB_DIR}/sms_sender.sh"
    # shellcheck disable=SC1091
    source "${LIB_DIR}/sms_receiver.sh"
    # shellcheck disable=SC1091
    source "${LIB_DIR}/state_manager.sh"
    # shellcheck disable=SC1091
    source "${LIB_DIR}/notifier.sh"
}

show_help() {
    echo -e "${BLUE}CardPulse - SIM keepalive over AT serial${NC}"
    echo "Version: ${VERSION}"
    echo ""
    echo "Usage: cardpulse [options]"
    echo ""
    echo "Options:"
    echo "  -c, --config FILE    Use a specific config file"
    echo "  -f, --force          Send even when interval has not elapsed"
    echo "  -s, --status         Show local send state"
    echo "  -t, --test           Send a test SMS without recording state"
    echo "  -i, --info           Show modem information"
    echo "  --sms-status         Show SMS storage and receive status"
    echo "  --inbox              List SMS inbox entries without deleting them"
    echo "  --read-sms INDEX     Read one SMS by index"
    echo "  --delete-sms INDEX   Delete one SMS by index; requires --confirm DELETE_SMS"
    echo "  --confirm TOKEN      Confirmation token for dangerous actions"
    echo "  -r, --reset          Reset local send state"
    echo "  -n, --notify         Test notification delivery"
    echo "  --notify-channel CH  Test one notification channel (telegram|wechat|wecom|qq|feishu|dingtalk|bark|email)"
    echo "  --doctor             Run diagnostics; will not send SMS or write CardPulse state"
    echo "  -v, --version        Show version"
    echo "  -h, --help           Show help"
    echo ""
    echo "Examples:"
    echo "  cardpulse --doctor"
    echo "  cardpulse --info"
    echo "  cardpulse --test"
    echo "  cardpulse --status"
}

show_version() {
    echo "CardPulse ${VERSION}"
}

require_arg() {
    local option="$1"
    local value="${2:-}"
    if [[ -z "$value" || "$value" == -* ]]; then
        echo -e "${RED}[ERROR] Option $option requires an argument${NC}" >&2
        show_help >&2
        exit 1
    fi
}

validate_notify_channel() {
    local channel="$1"
    case "$channel" in
        telegram|wechat|wecom|qq|feishu|dingtalk|bark|email) return 0 ;;
        *)
            echo -e "${RED}[ERROR] Unknown notification channel: $channel${NC}" >&2
            echo "Allowed: telegram, wechat, wecom, qq, feishu, dingtalk, bark, email" >&2
            exit 1
            ;;
    esac
}

validate_sms_index_arg() {
    local index="$1"
    if [[ ! "$index" =~ ^[0-9]+$ ]]; then
        echo -e "${RED}[ERROR] SMS index must be a single non-negative integer${NC}" >&2
        exit 1
    fi
}

with_sms_device() {
    local action="$1"
    local index="${2:-}"
    local device
    device=$(sms_detect_device) || device=""
    if [[ -z "$device" ]]; then
        echo -e "${RED}[ERROR] No AT serial port found.${NC}" >&2
        echo "[INFO] Run 'cardpulse --doctor' for read-only diagnostics." >&2
        exit 1
    fi

    local baudrate
    baudrate=$(config_read ".serial.baudrate" "115200")
    if ! at_init "$device" "$baudrate"; then
        echo -e "${RED}[ERROR] Failed to open serial port.${NC}" >&2
        exit 1
    fi

    local exit_code=0
    case "$action" in
        status) sms_receive_status || exit_code=$? ;;
        inbox) sms_receive_list || exit_code=$? ;;
        read) sms_receive_read "$index" || exit_code=$? ;;
        delete) sms_receive_delete "$index" || exit_code=$? ;;
        *) echo -e "${RED}[ERROR] Unknown SMS action: $action${NC}" >&2; exit_code=1 ;;
    esac
    at_close
    exit "$exit_code"
}

acquire_singleton_lock() {
    CARDPULSE_LOCK_FILE="${STATE_DIR}/cardpulse.lock"
    exec 200>"$CARDPULSE_LOCK_FILE"

    if command -v flock >/dev/null 2>&1; then
        if ! flock -n -x 200 2>/dev/null; then
            echo -e "${YELLOW}[WARN] Another CardPulse instance is already running; exiting.${NC}" >&2
            exit 0
        fi
    else
        echo -e "${YELLOW}[WARN] flock not found; skipping singleton lock for macOS manual testing.${NC}" >&2
    fi
}

doctor_command_status() {
    local command_name="$1"
    if command -v "$command_name" >/dev/null 2>&1; then
        echo "OK"
    else
        echo "MISSING"
    fi
}

doctor_timeout_status() {
    if command -v timeout >/dev/null 2>&1 || command -v gtimeout >/dev/null 2>&1; then
        echo "OK"
    else
        echo "MISSING"
    fi
}

doctor_yaml_status() {
    if command -v yq >/dev/null 2>&1; then
        echo "OK (yq)"
    elif command -v python3 >/dev/null 2>&1 && python3 -c 'import yaml' >/dev/null 2>&1; then
        echo "OK (python3 yaml)"
    else
        echo "MISSING"
    fi
}

doctor_list_serial_candidates() {
    local found=false
    local pattern
    local device

    for pattern in /dev/ttyUSB* /dev/ttyACM* /dev/cu.usbserial* /dev/cu.usbmodem* /dev/cu.wchusbserial* /dev/cu.SLAB_USBtoUART* /dev/cu.usb*; do
        for device in $pattern; do
            if [[ -e "$device" ]]; then
                echo "  - $device"
                found=true
            fi
        done
    done

    if [[ "$found" != "true" ]]; then
        echo "  No AT serial port found"
    fi
}

doctor_list_wwan_candidates() {
    local control_found=false
    local network_found=false
    local pattern
    local device
    local dev_root="${CARDPULSE_DEV_ROOT:-/dev}"
    local sys_root="${CARDPULSE_SYS_ROOT:-/sys}"

    echo "  Control candidates:"
    for pattern in "$dev_root"/cdc-wdm* "$dev_root"/wwan*qmi* "$dev_root"/wwan*mbim*; do
        for device in $pattern; do
            if [[ -e "$device" ]]; then
                echo "  - $device"
                control_found=true
            fi
        done
    done
    if [[ "$control_found" != "true" ]]; then
        echo "  - none"
    fi

    echo "  Network candidates:"
    for pattern in "$dev_root"/wwan* "$sys_root"/class/wwan/*; do
        for device in $pattern; do
            if [[ -e "$device" ]]; then
                echo "  - $device"
                network_found=true
            fi
        done
    done
    if [[ "$network_found" != "true" ]]; then
        echo "  - none"
    fi
}

doctor_wwan_hints() {
    local found=false
    local driver
    local path
    local dev_root="${CARDPULSE_DEV_ROOT:-/dev}"
    local sys_root="${CARDPULSE_SYS_ROOT:-/sys}"

    for driver in "$sys_root"/bus/usb/drivers/cdc_mbim/* "$sys_root"/bus/usb/drivers/qmi_wwan/* "$sys_root"/bus/usb/drivers/wwan_qmi/*; do
        if [[ -L "$driver" ]]; then
            path=$(readlink "$driver" 2>/dev/null || echo "$driver")
            echo "  - $(basename "$(dirname "$driver")") bound: $(basename "$driver") -> $path"
            found=true
        fi
    done

    for path in "$dev_root"/cdc-wdm* "$dev_root"/wwan*qmi* "$dev_root"/wwan*mbim*; do
        if [[ -e "$path" ]]; then
            found=true
        fi
    done

    [[ "$found" == "true" ]]
}

doctor_usb_hints() {
    local found=false
    local output=""
    local line

    if command -v system_profiler >/dev/null 2>&1; then
        output=$(system_profiler SPUSBDataType 2>/dev/null | LC_ALL=C grep -Ei 'Baiwang|DJI|Quectel|Huawei|SIMCom|SIM7600|EC20|EC25|2CA3|4006' || true)
        if [[ -n "$output" ]]; then
            while IFS= read -r line; do
                printf '  %s\n' "$line"
            done <<< "$output"
            found=true
        fi
    fi

    if command -v ioreg >/dev/null 2>&1; then
        output=$(ioreg -p IOUSB -l -w 0 2>/dev/null | LC_ALL=C grep -Ei 'Baiwang|DJI|Quectel|Huawei|SIMCom|SIM7600|EC20|EC25|2CA3|4006|idVendor.*11427|idProduct.*16390' || true)
        if [[ -n "$output" ]]; then
            while IFS= read -r line; do
                printf '  %s\n' "$line"
            done <<< "$output"
            found=true
        fi
    fi

    if command -v lsusb >/dev/null 2>&1; then
        output=$(lsusb 2>/dev/null | LC_ALL=C grep -Ei 'Baiwang|DJI|Quectel|Huawei|SIMCom|SIM7600|EC20|EC25|2CA3|4006' || true)
        if [[ -n "$output" ]]; then
            while IFS= read -r line; do
                printf '  %s\n' "$line"
            done <<< "$output"
            found=true
        fi
    fi

    if [[ "$found" != "true" ]]; then
        echo "  No known USB modem hints found"
        return 1
    fi

    return 0
}

run_doctor() {
    echo "=== CardPulse doctor ==="
    echo "Mode: diagnostics; will not send SMS or write CardPulse state."
    echo "Note: when an AT serial port exists, doctor sends AT query commands."
    echo ""

    echo "Dependencies:"
    echo "  bash: ${BASH_VERSION}"
    echo "  stty: $(doctor_command_status stty)"
    echo "  timeout/gtimeout: $(doctor_timeout_status)"
    echo "  python3: $(doctor_command_status python3)"
    echo "  yaml parser: $(doctor_yaml_status)"
    echo "  flock: $(doctor_command_status flock)"
    echo ""

    echo "Serial candidates:"
    doctor_list_serial_candidates
    echo ""

    local wwan_control_found=false
    echo "Linux MBIM/QMI candidates:"
    doctor_list_wwan_candidates
    if doctor_wwan_hints; then
        wwan_control_found=true
    fi
    echo ""

    local usb_hints_found=false
    echo "USB hints:"
    if doctor_usb_hints; then
        usb_hints_found=true
    fi
    echo ""

    if ! config_init; then
        echo "Config: unavailable"
        echo "Result: cannot read config. Hardware diagnostics above are still valid."
        echo "Next: fix the config file or YAML parser before running --info or --test."
        return 2
    fi

    echo "Config:"
    echo "  file: ${CONFIG_FILE}"
    echo "  serial.port: $(config_read '.serial.port' '')"
    echo "  serial.baudrate: $(config_read '.serial.baudrate' '115200')"
    echo "  serial.auto_detect: $(config_read '.serial.auto_detect' 'true')"
    echo ""

    local device
    device=$(sms_detect_device) || device=""
    if [[ -z "$device" ]]; then
        echo "Result: No AT serial port found"
        if [[ "$wwan_control_found" == "true" ]]; then
            echo "Detail: Linux MBIM/QMI control candidate found, but CardPulse currently supports AT serial only."
            echo "Next: use an MBIM/QMI-capable tool such as VoHive, or add an MBIM/QMI backend to CardPulse."
        elif [[ "$usb_hints_found" == "true" ]]; then
            echo "Detail: USB device found, but no AT serial port is exposed. USB enumeration is not enough for CardPulse."
        else
            echo "Detail: No configured or auto-detected AT serial port was found."
        fi
        echo "Expected ports include /dev/ttyUSB*, /dev/ttyACM*, /dev/cu.usbserial*, and /dev/cu.usbmodem*."
        return 2
    fi

    local baudrate
    baudrate=$(config_read '.serial.baudrate' '115200')
    echo "AT handshake:"
    echo "  device: $device"
    echo "  baudrate: $baudrate"

    if ! at_init "$device" "$baudrate"; then
        echo "  result: serial open failed"
        return 3
    fi

    if ! at_check_modem; then
        echo "  AT: no response"
        at_close
        return 4
    fi

    local sim_status
    local rssi
    local network_status
    local operator
    sim_status=$(at_check_sim || true)
    rssi=$(at_check_signal || true)
    network_status=$(at_check_network || true)
    operator=$(at_check_operator || true)

    echo "  AT: OK"
    echo "  SIM: ${sim_status:-UNKNOWN}"
    echo "  RSSI: ${rssi:-UNKNOWN}"
    echo "  Network registration: ${network_status:-UNKNOWN}"
    echo "  Operator: ${operator:-UNKNOWN}"
    at_close
}

main() {
    local force_send=false
    local show_status=false
    local test_mode=false
    local show_info=false
    local reset_state=false
    local test_notify=false
    local doctor_mode=false
    local sms_status=false
    local sms_inbox=false
    local read_sms_index=""
    local delete_sms_index=""
    local confirm_token=""
    local notify_channel=""
    local config_path=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -c|--config)
                require_arg "$1" "${2:-}"
                config_path="$2"
                shift 2
                ;;
            -f|--force)
                force_send=true
                shift
                ;;
            -s|--status)
                show_status=true
                shift
                ;;
            -t|--test)
                test_mode=true
                shift
                ;;
            -i|--info)
                show_info=true
                shift
                ;;
            --sms-status)
                sms_status=true
                shift
                ;;
            --inbox)
                sms_inbox=true
                shift
                ;;
            --read-sms)
                require_arg "$1" "${2:-}"
                validate_sms_index_arg "$2"
                read_sms_index="$2"
                shift 2
                ;;
            --delete-sms)
                require_arg "$1" "${2:-}"
                validate_sms_index_arg "$2"
                delete_sms_index="$2"
                shift 2
                ;;
            --confirm)
                require_arg "$1" "${2:-}"
                confirm_token="$2"
                shift 2
                ;;
            -r|--reset)
                reset_state=true
                shift
                ;;
            -n|--notify)
                test_notify=true
                shift
                ;;
            --notify-channel)
                require_arg "$1" "${2:-}"
                notify_channel="$2"
                validate_notify_channel "$notify_channel"
                shift 2
                ;;
            --doctor)
                doctor_mode=true
                shift
                ;;
            -v|--version)
                show_version
                exit 0
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            *)
                echo -e "${RED}[ERROR] Unknown option: $1${NC}" >&2
                show_help >&2
                exit 1
                ;;
        esac
    done

    if [[ -n "$notify_channel" && "$test_notify" != "true" ]]; then
        echo -e "${RED}[ERROR] --notify-channel requires --notify${NC}" >&2
        exit 1
    fi
    if [[ -n "$delete_sms_index" && "$confirm_token" != "DELETE_SMS" ]]; then
        echo -e "${RED}[ERROR] --delete-sms requires --confirm DELETE_SMS${NC}" >&2
        exit 1
    fi

    load_modules

    if [[ -n "$config_path" ]]; then
        CONFIG_FILE="$config_path"
    fi

    if [[ "$doctor_mode" == "true" ]]; then
        run_doctor
        exit $?
    fi

    if ! config_init; then
        exit 1
    fi

    if [[ "$show_info" == "true" ]]; then
        local device
        device=$(sms_detect_device) || device=""
        if [[ -z "$device" ]]; then
            echo -e "${RED}[ERROR] No AT serial port found.${NC}" >&2
            echo "[INFO] Run 'cardpulse --doctor' for read-only diagnostics." >&2
            exit 1
        fi
        local baudrate
        baudrate=$(config_read ".serial.baudrate" "115200")
        if at_init "$device" "$baudrate"; then
            at_show_info
            at_close
        else
            echo -e "${RED}[ERROR] Failed to open serial port.${NC}" >&2
            exit 1
        fi
        exit 0
    fi

    if [[ "$sms_status" == "true" ]]; then
        with_sms_device status
    fi
    if [[ "$sms_inbox" == "true" ]]; then
        with_sms_device inbox
    fi
    if [[ -n "$read_sms_index" ]]; then
        with_sms_device read "$read_sms_index"
    fi
    if [[ -n "$delete_sms_index" ]]; then
        with_sms_device delete "$delete_sms_index"
    fi

    state_init
    acquire_singleton_lock

    if [[ "$show_status" == "true" ]]; then
        state_show_status
        exit 0
    fi

    if [[ "$reset_state" == "true" ]]; then
        state_reset
        echo -e "${GREEN}[INFO] State reset.${NC}"
        exit 0
    fi

    if [[ "$test_notify" == "true" ]]; then
        notify_test "$notify_channel"
        exit $?
    fi

    if ! config_validate; then
        exit 1
    fi

    local phone
    local message
    local interval_days
    phone=$(config_read ".sms.phone" "")
    message=$(config_read ".sms.message" "Hello from CardPulse")
    interval_days=$(config_read ".sms.interval_days" "179")

    local device
    device=$(sms_detect_device) || device=""
    if [[ -z "$device" ]]; then
        echo -e "${RED}[ERROR] No AT serial port found.${NC}" >&2
        echo "[INFO] Check that the 4G module exposes an AT serial port such as /dev/ttyUSB*, /dev/ttyACM*, or /dev/cu.usb*." >&2
        echo "[INFO] Run 'cardpulse --doctor' for read-only diagnostics." >&2
        exit 1
    fi

    local baudrate
    baudrate=$(config_read ".serial.baudrate" "115200")

    if [[ "$test_mode" == "true" ]]; then
        local phone_masked
        phone_masked=$(config_mask_string "$phone")
        echo -e "${BLUE}[INFO] Test mode: this sends a real SMS.${NC}"
        echo "[INFO] Target phone: $phone_masked" >&2
        echo "[INFO] Message length: ${#message} chars" >&2

        if ! at_init "$device" "$baudrate"; then
            echo -e "${RED}[ERROR] Failed to open serial port.${NC}" >&2
            exit 1
        fi

        if ! sms_validate_preconditions; then
            at_close
            exit 1
        fi

        local result
        local exit_code=0
        result=$(sms_send_with_retry "$phone" "$message") || exit_code=$?

        at_close

        if [[ $exit_code -eq 0 ]]; then
            echo -e "${GREEN}[SUCCESS] SMS sent.${NC}"
            echo "[INFO] Message reference: $result"
        else
            echo -e "${RED}[ERROR] SMS send failed.${NC}"
            exit 1
        fi

        exit 0
    fi

    if [[ "$force_send" != "true" ]]; then
        if ! state_should_send "$interval_days"; then
            local remaining
            local last_date
            remaining=$(state_get_remaining "$interval_days")
            last_date=$(state_get_last_success_date)
            echo -e "${GREEN}[INFO] Next send is in ${remaining} days.${NC}"
            echo "[INFO] Last success: $last_date"
            exit 0
        fi
    fi

    local phone_masked
    phone_masked=$(config_mask_string "$phone")
    echo -e "${BLUE}[INFO] Starting keepalive send...${NC}"
    echo "[INFO] Target phone: $phone_masked" >&2
    echo "[INFO] Message length: ${#message} chars" >&2
    echo "[INFO] Serial device: $device" >&2
    echo ""

    if ! at_init "$device" "$baudrate"; then
        echo -e "${RED}[ERROR] Failed to open serial port.${NC}" >&2
        notify_send "failure" "$device" "$phone" "$message"
        exit 1
    fi

    if ! sms_validate_preconditions; then
        at_close
        notify_send "failure" "$device" "$phone" "$message"
        exit 1
    fi

    echo -e "${BLUE}[INFO] Sending SMS...${NC}"
    local result
    local exit_code=0
    result=$(sms_send_with_retry "$phone" "$message") || exit_code=$?

    at_close

    if [[ $exit_code -eq 0 ]]; then
        state_record_success
        notify_send "success" "$device" "$phone" "$message"
        echo -e "${GREEN}[SUCCESS] SMS sent.${NC}"
        echo "[INFO] Message reference: $result"
    else
        state_record_failure
        notify_send "failure" "$device" "$phone" "$message"
        echo -e "${RED}[ERROR] SMS send failed.${NC}"
        exit 1
    fi
}

main "$@"

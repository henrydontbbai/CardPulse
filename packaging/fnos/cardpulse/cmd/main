#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$SCRIPT_DIR/cardpulse-device-mode.sh"

case "${1:-}" in
start)
    # fnOS owns the Compose project lifecycle. Refresh only the selected
    # template before the platform starts the project.
    select_cardpulse_device_mode
    ;;
stop)
    # App Center owns the Docker Compose lifecycle.
    exit 0
    ;;
status)
    # Query the managed service through its gateway socket instead of assuming
    # that the package user can access the Docker CLI socket.
    if [ -S "${TRIM_APPDEST}/app.sock" ]; then
        if curl --fail --silent --show-error --max-time 2 \
            --unix-socket "${TRIM_APPDEST}/app.sock" \
            -H "X-Trim-Isadmin: true" \
            http://localhost/app/cardpulse/api/health 2>/dev/null | \
            grep -Eq '"status"[[:space:]]*:[[:space:]]*"ok"'; then
            exit 0
        fi
    fi
    exit 3
    ;;
*)
    exit 1
    ;;
esac

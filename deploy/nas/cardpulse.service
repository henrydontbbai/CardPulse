[Unit]
Description=CardPulse daily keepalive check
Requires=cardpulse-modem-ready.service
After=cardpulse-modem-ready.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cardpulse
Group=cardpulse
Environment=CARDPULSE_CONFIG_DIR=/var/lib/cardpulse/config
Environment=CARDPULSE_STATE_DIR=/var/lib/cardpulse/state
ExecStart=/usr/local/bin/cardpulse
WorkingDirectory=/var/lib/cardpulse
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cardpulse

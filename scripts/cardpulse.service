[Unit]
Description=CardPulse - SIM卡定时保号工具
After=network.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/cardpulse
WorkingDirectory=/root/.cardpulse

# 安全限制
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/root/.cardpulse

# 环境变量
Environment=CARDPULSE_CONFIG_DIR=/root/.cardpulse

[Install]
WantedBy=multi-user.target
